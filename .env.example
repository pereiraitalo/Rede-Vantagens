# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - REDE+ GESTÃO TJPA
# ==============================================================================
# Este é um arquivo de modelo. NUNCA insira chaves reais ou segredos aqui.
# Para desenvolvimento local, copie este arquivo para '.env.local':
#   cp .env.example .env.local
# E preencha com as credenciais do seu projeto Firebase (Console do Firebase > Configurações do Projeto > Web Apps).

# Firebase Web App Configuration (Client-side)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""

# Gemini API / Backend Integration (Opcional - Server-side only)
GEMINI_API_KEY=""

# Application Host URL (Injetado automaticamente em produção)
APP_URL="http://localhost:3000"
